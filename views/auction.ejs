<% if (typeof flash !== 'undefined' && flash && !error) { %><div class="flash success"><%= flash %></div><% } %>
<p class="eyebrow"><%= auction.house_name %><% if (auction.location) { %> · <%= auction.location %><% } %></p>
<h1><%= auction.title %></h1>
<% if (season) { %><p class="muted"><small>Season <%= season %> — a new edition of this sale.</small></p><% } %>
<p class="lede">
  <span class="pill <%= auction.status %>"><%= auction.status %></span>
  <%= auction.format %> · starts <%= formatCentral(auction.starts_at) %><% if (auction.closes_at) { %> · closes <%= formatCentral(auction.closes_at) %><% } %>
</p>
<% if (auction.source_url) { %><p><a class="btn" href="<%= auction.source_url %>">View at <%= auction.house_name %> →</a></p><% } %>

<div class="lot-grid">
  <% for (const lot of lots) { %>
    <%- include('partials/lot-card', { lot, userId, userPath, formatMoney }) %>
  <% } %>
</div>
