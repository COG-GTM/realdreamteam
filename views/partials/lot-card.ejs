<%#
  Lot card. Expects `lot` (id, title, artist, category, currency, estimate_low,
  estimate_high, starting_bid, image_url, current_bid, high_bidder, favorited,
  status, hammer_price, winner_name — everything after currency is optional)
  and `userId`. Pass an optional `reasons` array to show why the lot matched.
%>
<% const cardReasons = typeof reasons !== 'undefined' && Array.isArray(reasons) ? reasons : []; %>
<% const lotHref = `/lots/${lot.id}${userId ? `?u=${userId}` : ''}`; %>
<article class="lot-card">
  <% if (lot.status === 'closed' && lot.hammer_price) { %><span class="sold-ribbon">SOLD</span><% } %>
  <a class="lot-card-image" href="<%= lotHref %>">
    <% if (lot.image_url) { %>
      <img src="<%= lot.image_url %>" alt="<%= lot.title %>" loading="lazy">
    <% } else { %>
      <span class="lot-card-placeholder">No image</span>
    <% } %>
  </a>
  <div class="lot-card-body">
    <p class="eyebrow"><%= lot.category %></p>
    <h3><a href="<%= lotHref %>"><%= lot.title %></a><% if (lot.favorited) { %> <span class="fav" title="Favorited">♥</span><% } %></h3>
    <% if (lot.artist) { %><p class="lot-card-artist"><%= lot.artist %></p><% } %>
    <% if (lot.estimate_low || lot.estimate_high) { %>
      <p class="lot-card-meta">Estimate <%= formatMoney(lot.estimate_low, lot.currency) %>–<%= formatMoney(lot.estimate_high, lot.currency) %></p>
    <% } %>
    <p class="lot-card-bid">
      <% if (lot.status === 'closed' && lot.hammer_price) { %>
        Sold for <b><%= formatMoney(lot.hammer_price, lot.currency) %></b><% if (lot.winner_name) { %> to <%= lot.winner_name %><% } %>
      <% } else if (lot.status === 'closed') { %>
        Unsold
      <% } else if (lot.current_bid) { %>
        Current bid <b><%= formatMoney(lot.current_bid, lot.currency) %></b><% if (lot.high_bidder) { %> by <%= lot.high_bidder %><% } %>
      <% } else if (lot.starting_bid) { %>
        Starting bid <b><%= formatMoney(lot.starting_bid, lot.currency) %></b>
      <% } else { %>
        No bids yet
      <% } %>
    </p>
    <% if (lot.bid_count != null || lot.watch_count != null) { %>
      <p class="lot-card-stats muted"><small><%= lot.bid_count || 0 %> bid<%= (lot.bid_count || 0) === 1 ? '' : 's' %> · <%= lot.watch_count || 0 %> watching</small></p>
    <% } %>
    <% if (cardReasons.length) { %>
      <ul class="lot-card-reasons">
        <% for (const reason of cardReasons) { %><li><%= reason %></li><% } %>
      </ul>
    <% } %>
  </div>
</article>
