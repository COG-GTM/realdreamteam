<%# include('partials/avatar', { person, size }) — person needs id, name, avatar_url, has_upload %>
<% const src = person.has_upload ? `/avatars/${person.id}` : (person.avatar_url || null); %>
<% const cls = `avatar${typeof size !== 'undefined' && size ? ` avatar-${size}` : ''}`; %>
<% if (src) { %><img class="<%= cls %>" src="<%= src %>" alt="" width="45" height="45" loading="lazy"><% } else { %><span class="<%= cls %>" aria-hidden="true"><%= person.name.split(' ').map((part) => part[0]).join('').slice(0, 2) %></span><% } %>
