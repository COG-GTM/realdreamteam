<% if (bids.length === 0) { %>
  <p class="lede">No bids yet.</p>
<% } else { %>
  <table class="table">
    <tr><th>Bidder</th><th>Amount</th><th>Time</th></tr>
    <% for (const bid of bids) { %>
      <tr><td class="bidder"><%- include('avatar', { person: bid, size: 'sm' }) %> <%= bid.name %></td><td><%= formatMoney(bid.amount, lot.currency) %></td><td><%= formatCentral(bid.placed_at) %></td></tr>
    <% } %>
  </table>
<% } %>
