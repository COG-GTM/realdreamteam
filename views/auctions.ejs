<% if (typeof flash !== 'undefined' && flash && !error) { %><div class="flash success"><%= flash %></div><% } %>
<p class="eyebrow">Auctions</p>
<h1>Browse auctions</h1>

<% const sections = [['open', 'Open now'], ['upcoming', 'Upcoming'], ['closed', 'Closed']]; %>
<% for (const [key, label] of sections) { %>
  <section class="auction-section">
    <h2 class="section-heading"><%= label %></h2>
    <% if (groups[key].length === 0) { %>
      <p class="lede">None right now.</p>
    <% } %>
    <% for (const auction of groups[key]) { %>
      <a class="auction-card" href="<%= userPath(userId, '/auctions/' + auction.id) %>">
        <% const houseSlug = String(auction.house_name || '').toLowerCase().replace(/[^a-z0-9]+/g, ''); %>
        <div>
          <p class="eyebrow house-row">
            <img class="house-logo small" src="/logos/<%= houseSlug %>.svg" alt="<%= auction.house_name %>" data-fallback="/logos/<%= houseSlug %>.png"
                 onerror="if (this.dataset.fallback) { this.src = this.dataset.fallback; this.dataset.fallback = ''; } else { this.hidden = true; this.nextElementSibling.hidden = false; }">
            <span hidden><%= auction.house_name %></span>
          </p>
          <h3><%= auction.title %></h3>
          <p class="muted"><%= auction.location || '' %> · <%= auction.format %> · <%= auction.lot_count %> lot<%= auction.lot_count === 1 ? '' : 's' %></p>
          <p class="muted">Starts <%= formatCentral(auction.starts_at) %><% if (auction.closes_at) { %> · Closes <%= formatCentral(auction.closes_at) %><% } %><% if (auction.ends_soon) { %> · <span class="ends-soon" data-closes-at="<%= new Date(auction.closes_at).toISOString() %>"></span><% } %></p>
        </div>
        <span class="pill <%= auction.status %>"><%= auction.status %></span>
      </a>
    <% } %>
  </section>
<% } %>
