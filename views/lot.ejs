<% if (typeof flash !== 'undefined' && flash && !error) { %><div class="flash success"><%= flash %></div><% } %>
<p class="eyebrow"><a href="<%= userPath(userId, '/auctions/' + lot.auction_id) %>"><%= lot.house_name %> · <%= lot.auction_title %></a></p>
<h1><%= lot.title %></h1>

<% if (lot.auction_status === 'closed') { %>
  <% if (lot.hammer_price != null) { %>
    <div class="sold-banner"><% if (lot.winner_name) { %><%- include('partials/avatar', { person: { id: lot.winner_user_id, name: lot.winner_name, avatar_url: lot.winner_avatar_url, has_upload: lot.winner_has_upload }, size: 'sm' }) %> <% } %>SOLD — Sold to <%= lot.winner_name || 'a bidder' %> for <%= formatMoney(lot.hammer_price, lot.currency) %></div>
  <% } else { %>
    <div class="sold-banner">Unsold</div>
  <% } %>
<% } %>

<% if (images.length > 0) { %>
  <div class="gallery">
    <% for (const image of images) { %>
      <figure>
        <a href="<%= lot.source_url || image.url %>"><img src="<%= image.url %>" alt="<%= lot.title %>"></a>
        <% if (image.credit) { %><figcaption class="muted"><%= image.credit %></figcaption><% } %>
      </figure>
    <% } %>
  </div>
<% } %>

<div class="lot-detail">
  <div>
    <% if (lot.artist) { %><p class="muted"><%= lot.artist %></p><% } %>
    <p class="muted"><%= lot.category %></p>
    <% if (lot.description) { %><p><%= lot.description %></p><% } %>
    <% if (lot.estimate_low != null || lot.estimate_high != null) { %>
      <p class="muted">Estimate <%= formatMoney(lot.estimate_low, lot.currency) %> – <%= formatMoney(lot.estimate_high, lot.currency) %></p>
    <% } %>
    <% if (lot.starting_bid != null) { %><p class="muted">Starting bid <%= formatMoney(lot.starting_bid, lot.currency) %></p><% } %>
    <% if (lot.source_url) { %><p><a class="btn" href="<%= lot.source_url %>">View on Wikipedia/source →</a></p><% } %>
    <p class="muted"><%= lot.house_name %> · <a href="<%= userPath(userId, '/auctions/' + lot.auction_id) %>"><%= lot.auction_title %></a> · <span class="pill <%= lot.auction_status %>"><%= lot.auction_status %></span></p>
  </div>

  <div class="bid-panel">
    <div id="lot-bidding" data-src="<%= livePath('bidding') %>">
      <%- include('partials/lot-bidding') %>
    </div>

    <button type="button" class="linklike" id="bidding-rules-link">Bidding rules</button>
    <dialog id="bidding-rules">
      <h2>Bidding rules</h2>
      <ul>
        <li>Amounts may include cents/pence (two decimals).</li>
        <li>A bid must beat the current price by at least one step (table below).</li>
        <li>Amounts between steps are rounded down to the nearest step.</li>
        <li>A single bid can't exceed 1.1× the current price (2× under 100), but you can always bid at least 3 steps up.</li>
        <li>The high bidder can't raise their own bid.</li>
        <li>Bids are final.</li>
        <li>The first bid on a lot must be at least the starting bid (or low estimate).</li>
      </ul>
      <table class="table">
        <tr><th>Current price</th><th>Step</th></tr>
        <% let lowerBound = 0; for (const [upperBound, step] of INCREMENTS) { %>
          <tr class="<%= step === increment ? 'current-step' : '' %>">
            <td><%= formatMoney(lowerBound, lot.currency) %><%= upperBound === Infinity ? '+' : ' – under ' + formatMoney(upperBound, lot.currency) %></td>
            <td><%= formatMoney(step, lot.currency) %></td>
          </tr>
          <% lowerBound = upperBound; %>
        <% } %>
      </table>
      <button type="button" class="btn" id="bidding-rules-close">Close</button>
    </dialog>

    <% if (userId) { %>
      <form method="post" action="<%= userPath(userId, '/lots/' + lot.id + '/favorite') %>">
        <button class="btn" type="submit"><%= favorited ? '♥ Favorited' : '♡ Favorite' %></button>
      </form>
    <% } %>
  </div>
</div>

<h2 class="section-heading">Bid history</h2>
<div id="lot-history" data-src="<%= livePath('history') %>">
  <%- include('partials/lot-history') %>
</div>

<audio id="sold-sound" src="/sold.mp3"></audio>
<script>
  var rulesLink = document.getElementById('bidding-rules-link');
  var rulesDialog = document.getElementById('bidding-rules');
  var rulesClose = document.getElementById('bidding-rules-close');
  if (rulesLink && rulesDialog) rulesLink.addEventListener('click', function () { rulesDialog.showModal(); });
  if (rulesClose && rulesDialog) rulesClose.addEventListener('click', function () { rulesDialog.close(); });
  // Delegated: the bid form lives inside a live-refreshed region and is replaced wholesale.
  document.addEventListener('submit', function (event) {
    var bidForm = event.target.closest('.bid-form');
    if (!bidForm) return;
    var amountText = bidForm.elements.amount.value.replace(/,/g, '');
    var amount = Number(amountText);
    var estimateHigh = <%= lot.estimate_high == null ? 'null' : Number(lot.estimate_high) %>;
    if (amount >= 1000000 || (estimateHigh && amount >= 10 * estimateHigh)) {
      var formattedAmount = amount.toLocaleString('en-US', { maximumFractionDigits: 2 });
      if (!window.confirm('You are bidding ' + formattedAmount + ' — is that right?')) {
        event.preventDefault();
      }
    }
  });
  if (document.querySelector('.sold-banner') && location.search.indexOf('justClosed=1') !== -1) {
    var sound = document.getElementById('sold-sound');
    if (sound) sound.play().catch(function () {});
  }
</script>
