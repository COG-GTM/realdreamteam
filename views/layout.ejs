<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Auction Interest</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <% if (typeof gate !== 'undefined' && gate) { %>
    <header class="site-header">
      <a class="brand" href="/">AUCTION<span>INTEREST</span></a>
    </header>
    <main class="page">
      <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
      <%- body %>
    </main>
  <% } else { %>
    <div class="shell">
      <aside class="sidenav">
        <a class="brand" href="/">AUCTION<span>INTEREST</span></a>
        <% if (user) { %>
          <span class="user-switch"><%- include('partials/avatar', { person: user, size: 'sm' }) %> You are <b><%= user.name %></b> · <a href="/">switch</a></span>
        <% } %>
        <nav>
          <% if (user) { %>
            <a href="/u/<%= user.id %>/summary">Summary</a>
            <a href="/auctions?u=<%= user.id %>">Auctions</a>
            <a href="/u/<%= user.id %>/history">History</a>
            <a href="/u/<%= user.id %>/preferences">Preferences</a>
          <% } %>
          <a href="/admin<%= user ? `?u=${user.id}` : '' %>">Admin</a>
        </nav>
        <form method="post" action="/signout" class="inline signout" title="Forget both codes in this browser">
          <button class="linklike" type="submit">Sign out</button>
        </form>
      </aside>
      <main class="page">
        <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
        <%- body %>
      </main>
      <aside class="panes">
        <section class="pane" id="pane-auctions" data-src="/panes/auctions?u=<%= userId %>">
          <%- include('partials/pane-auctions') %>
        </section>
        <section class="pane" id="pane-feed" data-src="/panes/feed?u=<%= userId %>">
          <%- include('partials/pane-feed') %>
        </section>
        <section class="pane" id="pane-live" data-src="/panes/live?u=<%= userId %>">
          <%- include('partials/pane-live') %>
        </section>
      </aside>
    </div>
  <% } %>
  <footer class="site-footer">A small demo for collecting auction interest.</footer>
  <% if (!(typeof gate !== 'undefined' && gate)) { %>
    <script>
      (() => {
        const panes = document.querySelectorAll('[data-src]');
        const panesAside = document.querySelector('.panes');
        let refreshing = false;
        let lastInput = Date.now();
        let paused = false;
        const pausedNote = document.createElement('p');
        pausedNote.className = 'panes-paused';
        pausedNote.textContent = 'Paused — move the mouse to resume';
        const IDLE_LIMIT = 60 * 60 * 1000;
        for (const type of ['mousemove', 'keydown', 'scroll', 'click', 'touchstart']) {
          window.addEventListener(type, () => {
            lastInput = Date.now();
            if (paused) {
              paused = false;
              panesAside.classList.remove('paused');
              pausedNote.remove();
              refresh();
            }
          }, { passive: true });
        }
        // Leave a region alone while the user is typing in it.
        function busy(pane) {
          if (pane.contains(document.activeElement) && document.activeElement.matches('input,textarea,select')) return true;
          return [...pane.querySelectorAll('input')].some((input) => input.value !== input.defaultValue);
        }
        async function refresh() {
          if (document.hidden || refreshing) return;
          if (Date.now() - lastInput > IDLE_LIMIT) {
            if (!paused) {
              paused = true;
              panesAside.classList.add('paused');
              panesAside.appendChild(pausedNote);
            }
            return;
          }
          refreshing = true;
          await Promise.all([...panes].map(async (pane) => {
            if (busy(pane)) return;
            const itemSelector = pane.id === 'pane-live' ? '.live-item' : '.unread';
            const oldIds = (pane.id === 'pane-feed' || pane.id === 'pane-live')
              ? new Set([...pane.querySelectorAll(itemSelector)].map((item) => item.dataset.id))
              : null;
            try {
              const response = await fetch(pane.dataset.src, { credentials: 'same-origin' });
              if (!response.ok) return;
              const html = await response.text();
              if (html === pane.innerHTML || busy(pane)) return;
              pane.innerHTML = html;
              if (oldIds) pane.querySelectorAll(itemSelector).forEach((item) => {
                if (!oldIds.has(item.dataset.id)) item.classList.add('fresh');
              });
            } catch {}
          }));
          refreshing = false;
        }
        setInterval(refresh, 3000);

        // "Ends in 42 min" countdowns on open auctions closing within 24 h.
        const endsNodes = document.querySelectorAll('.ends-soon[data-closes-at]');
        if (endsNodes.length) {
          const tickEnds = () => {
            const now = Date.now();
            for (const node of endsNodes) {
              const left = new Date(node.dataset.closesAt) - now;
              if (left <= 0) { node.textContent = 'Ends soon'; continue; }
              const mins = Math.ceil(left / 60000);
              node.textContent = mins >= 60
                ? `Ends in ${Math.floor(mins / 60)} h ${mins % 60} min`
                : `Ends in ${mins} min`;
            }
          };
          tickEnds();
          setInterval(tickEnds, 1000);
        }
      })();
    </script>
  <% } %>
</body>
</html>
