<% if (sold) { %><div class="sold-banner"><strong>SOLD!</strong><span>Sale closed and hammer prices recorded.</span><audio autoplay src="/sold.mp3"></audio><button class="btn" onclick="document.querySelector('audio').play()">▶ Play SOLD!</button></div><% } %>
<section class="section-head"><p class="eyebrow">OPERATIONS</p><h1>Admin</h1><p class="lede">Publish a lot or close a sale for the demo.</p></section>
<section class="panel form-panel"><h2>Add lot</h2><form method="post" action="/admin/items"><div class="form-grid"><label>Sale<select name="saleId" required><% sales.forEach((sale) => { %><option value="<%= sale.id %>"><%= sale.location %> · <%= sale.title %></option><% }) %></select></label><label>Lot number<input type="number" name="lotNumber" value="<%= nextLot %>"></label><label>Title<input name="title" required></label><label>Artist / maker<input name="artist"></label><label>Category<select name="category" required><% categories.forEach((category) => { %><option><%= category %></option><% }) %></select></label><label>Currency<input name="currency" placeholder="defaults from sale"></label><label>Estimate low<input type="number" name="estimateLow" required></label><label>Estimate high<input type="number" name="estimateHigh" required></label><label>Starting bid<input type="number" name="startingBid"></label><label>Image URL<input name="imageUrl"></label><label>Source URL<input name="sourceUrl"></label><label>Description<textarea name="description"></textarea></label></div><button class="btn primary" type="submit">Add lot</button></form></section>
<section class="panel"><h2>Sales</h2><div class="admin-sales"><% sales.forEach((sale) => { %><div class="admin-sale"><span><strong><%= sale.title %></strong><small><%= sale.location %> · <%= sale.itemCount %> lots · <span class="badge <%= sale.status %>"><%= sale.status %></span></small></span><% if (sale.status === 'closed') { %><form method="post" action="/admin/sales/<%= sale.id %>/reopen"><button class="btn">Reopen</button></form><% } else { %><form method="post" action="/admin/sales/<%= sale.id %>/close"><button class="btn danger">Close sale (hammer)</button></form><% } %></div><% }) %></div></section>
