<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Auction Interest</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">AUCTION<span>INTEREST</span></a>
    <nav>
      <% if (user) { %>
        <a href="/u/<%= user.id %>/summary">Summary</a>
        <a href="/sales?u=<%= user.id %>">Sales</a>
        <a href="/u/<%= user.id %>/history">History</a>
        <a href="/u/<%= user.id %>/preferences">Preferences</a>
      <% } else { %>
        <a href="/sales">Sales</a>
      <% } %>
      <a href="/admin<%= user ? `?u=${user.id}` : '' %>">Admin</a>
      <% if (user) { %><span class="user-switch">You are <b><%= user.name %></b> · <a href="/">switch</a></span><% } %>
    </nav>
  </header>
  <main class="page">
    <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
    <% if (typeof added !== 'undefined' && added) { %><div class="flash success"><%= added %></div><% } %>
    <%- body %>
  </main>
  <footer class="site-footer">A local demo for collecting auction interest.</footer>
</body>
</html>
