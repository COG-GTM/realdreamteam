<%- include('partials/flash') %>

<section class="summary-block">
  <div class="summary-heading">
    <h2>Matches your interests</h2>
    <a class="btn" href="/u/<%= userId %>/preferences">Edit preferences</a>
  </div>
  <% if (matches.length === 0) { %>
    <p class="empty-state">
      <% if (hasPreferences) { %>No open lots match your preferences right now. <% } %>
      <a class="invite" href="/u/<%= userId %>/preferences">Tell us what you like →</a>
    </p>
  <% } else { %>
    <div class="lot-grid">
      <% for (const lot of matches) { %>
        <%- include('partials/lot-card', { lot, userId, reasons: lot.reasons }) %>
      <% } %>
    </div>
  <% } %>
</section>

<section class="summary-block">
  <div class="summary-heading">
    <h2>Discover</h2>
    <a class="btn" href="/u/<%= userId %>/summary">Shuffle</a>
  </div>
  <% if (discover.length === 0) { %>
    <p class="empty-state">No open lots left to discover — you have already bid on or favorited everything.</p>
  <% } else { %>
    <div class="lot-grid">
      <% for (const lot of discover) { %>
        <%- include('partials/lot-card', { lot, userId }) %>
      <% } %>
    </div>
  <% } %>
</section>
